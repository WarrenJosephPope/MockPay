# Every configurable value in MockPay, with its default.
#
#   cp .env.example .env        then edit whatever you need
#
# Docker Compose reads .env from this directory automatically and injects these
# into the containers. Running from the CLI, export them or let the defaults in
# application*.yml apply — every value below has a fallback, so the project runs
# with no .env at all.
#
# .env is gitignored. .env.example is not: it is the documentation.

# ---------------------------------------------------------------------------
# Naming
# ---------------------------------------------------------------------------

# Prefix for container names. Deliberately NOT COMPOSE_PROJECT_NAME: Compose sets
# that from the top-level `name:` field, so interpolating it into container_name
# feeds on itself and yields mockpay-dev-postgres-dev.
CONTAINER_PREFIX=mockpay

# ---------------------------------------------------------------------------
# Ports
# ---------------------------------------------------------------------------

# The port the gateway listens on, inside the container and on the host alike.
# Change this one value and the published port, the container's own healthcheck,
# and the redirect URLs all follow.
GATEWAY_PORT=8088

# Host port for PostgreSQL. Deliberately not 5432, so it does not collide with a
# Postgres already installed on your machine. The port *inside* the container is
# always 5432 and is not configurable — nothing outside the compose network ever
# sees it.
POSTGRES_PORT=5433

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
POSTGRES_DB=mockpay
POSTGRES_USER=mockpay
POSTGRES_PASSWORD=mockpay

# Full JDBC URL. Compose overrides this for the containerised gateway, which
# reaches Postgres by service name on the internal network rather than via the
# published host port.
MOCKPAY_DB_URL=jdbc:postgresql://localhost:5433/mockpay

# Connection pool. A payment gateway is correctness-bound, not throughput-bound:
# a small, well-understood pool beats a large one, and a leak surfaces as a
# timeout rather than as silent exhaustion.
MOCKPAY_DB_POOL_MAX=10
MOCKPAY_DB_POOL_MIN_IDLE=2
MOCKPAY_DB_CONNECTION_TIMEOUT_MS=10000

# Where PostgreSQL keeps its files, relative to this directory. A bind mount, so
# you can see it, back it up, and delete it with rm -rf. Gitignored.
POSTGRES_DATA_DIR=./volumes/postgres

# ---------------------------------------------------------------------------
# Gateway
# ---------------------------------------------------------------------------

# What the gateway puts in 3DS, UPI and wallet redirect URLs. Must be reachable
# from the customer's BROWSER, not from inside the Docker network — so it stays
# localhost even when the gateway runs in a container.
MOCKPAY_PUBLIC_BASE_URL=http://localhost:8088

# Spring profile. `dev` = H2 in memory. `postgres` = PostgreSQL + Flyway.
SPRING_PROFILES_ACTIVE=dev

LOG_LEVEL=DEBUG

# ---------------------------------------------------------------------------
# Email (invitations, password resets)
# ---------------------------------------------------------------------------

# Leave MOCKPAY_SMTP_HOST EMPTY and nothing is sent: the gateway writes each message,
# link included, to its log. Local development and the test suite need no mail server.
#
# For a real inbox during development, start Mailpit from docker-compose.dev.yml and
# set the host to localhost — then read the mail at http://localhost:8025
MOCKPAY_SMTP_HOST=
MOCKPAY_SMTP_PORT=1025
MOCKPAY_SMTP_USERNAME=
MOCKPAY_SMTP_PASSWORD=
MOCKPAY_SMTP_AUTH=false
MOCKPAY_SMTP_STARTTLS=false

# The From address. Providers reject or spam-bin addresses that do not match an
# authenticated domain, so set this alongside real credentials.
MOCKPAY_MAIL_FROM=MockPay <no-reply@mockpay.local>

# Mailpit's published ports (docker-compose.dev.yml).
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025

# ---------------------------------------------------------------------------
# Simulated rail behaviour
# ---------------------------------------------------------------------------

# Latency injected into every simulated network call. Real card authorisations
# run 300-2000ms. Raise the maximum to test your own timeout handling.
MOCKPAY_RAIL_MIN_LATENCY_MS=120
MOCKPAY_RAIL_MAX_LATENCY_MS=400
MOCKPAY_RAIL_TIMEOUT_PROBABILITY=0.0

# ---------------------------------------------------------------------------
# Webhooks
# ---------------------------------------------------------------------------

# Exponential backoff schedule, in seconds, one entry per retry attempt.
MOCKPAY_WEBHOOK_BACKOFF_SECONDS=5,30,120,600,3600,21600
MOCKPAY_WEBHOOK_MAX_ATTEMPTS=6
MOCKPAY_WEBHOOK_TIMEOUT_MS=4000

# ---------------------------------------------------------------------------
# Idempotency
# ---------------------------------------------------------------------------

# How long a used idempotency key is remembered. 24 hours is the industry norm:
# long enough that a client retrying after an outage cannot double-charge,
# short enough that the table does not grow without bound.
MOCKPAY_IDEMPOTENCY_RETENTION_HOURS=24

# ---------------------------------------------------------------------------
# Pricing — the merchant discount rate charged on capture
# ---------------------------------------------------------------------------

# Basis points plus a fixed fee in minor units. 200 bps = 2.00%.
MOCKPAY_PRICING_CARD_BPS=200
MOCKPAY_PRICING_CARD_FIXED_MINOR=30

# UPI interchange is essentially zero for person-to-merchant payments, by
# regulatory design. That is not a placeholder; it is the point.
MOCKPAY_PRICING_UPI_BPS=0
MOCKPAY_PRICING_UPI_FIXED_MINOR=0

MOCKPAY_PRICING_WALLET_BPS=180
MOCKPAY_PRICING_WALLET_FIXED_MINOR=0

# ---------------------------------------------------------------------------
# Settlement
# ---------------------------------------------------------------------------

# Business days between capture and payout. Real acquirers hold funds because
# refunds and chargebacks arrive after the sale.
MOCKPAY_SETTLEMENT_DELAY_DAYS=2

# Timezone the settlement day is measured in. Captures are instants; a settlement
# period is a range of dates, so a zone has to decide which day each payment fell
# on. Acquirers publish a cut-off time in a named zone for the same reason.
MOCKPAY_SETTLEMENT_ZONE=UTC
