<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.0</version>
		<relativePath/>
	</parent>
	<groupId>dev.mockpay</groupId>
	<artifactId>gateway-service</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>gateway-service</name>
	<description>MockPay - a readable payment gateway simulator</description>

	<properties>
		<java.version>17</java.version>
	</properties>

	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>

		<!-- Dashboard authentication: session cookies, CSRF, filter chains. The
		     existing API-key filter becomes one chain among several rather than
		     being replaced. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>

		<!-- Sessions in PostgreSQL rather than in server memory. Survives a restart,
		     and lets an operator revoke a session by deleting a row.

		     Must be the *starter*. Boot 4 moved session auto-configuration into its
		     own module, so `org.springframework.session:spring-session-jdbc` alone
		     puts the repository on the classpath with nothing wiring it up:
		     `spring.session.store-type: jdbc` is then silently ignored, sessions
		     stay in Tomcat's memory, and SPRING_SESSION is never written to. Exactly
		     the same trap as flyway-core — in Boot 4, prefer the starter. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-session-jdbc</artifactId>
		</dependency>

		<!-- Outbound email: invitations and password resets. SMTP settings come from
		     the environment; with none configured the service logs the message
		     instead of sending, so local development needs no mail server. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-mail</artifactId>
		</dependency>

		<!-- Argon2 for PASSWORDS. Deliberately slow, because humans choose
		     guessable ones and the cost is what makes a stolen hash expensive to
		     crack. The opposite reasoning to API keys, which are high-entropy and
		     hashed with plain SHA-256 — see ApiKey. Spring Security's Argon2
		     encoder needs BouncyCastle on the classpath. -->
		<dependency>
			<groupId>org.bouncycastle</groupId>
			<artifactId>bcprov-jdk18on</artifactId>
			<version>1.78.1</version>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-h2console</artifactId>
		</dependency>

		<!-- Versioned schema migrations. Required on the `postgres` profile, where
		     Hibernate is forbidden from touching the schema.

		     Must be the *starter*, not plain flyway-core. Spring Boot 4 moved the
		     Flyway auto-configuration out of spring-boot-autoconfigure into its
		     own module, so flyway-core on its own puts the library on the
		     classpath with nothing to run it — migrations are silently skipped
		     and Hibernate then fails validation against an empty database. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>

		<!-- H2 backs the `dev` profile: zero-setup, in-memory, wiped on restart. -->
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- Postgres backs the `postgres` profile: the durable one. -->
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

</project>
